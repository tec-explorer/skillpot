{
  "name": "@tec-explorer/skillpot",
  "version": "0.18.0",
  "description": "Cross-agent skill supply chain security & governance layer for coding agents — install once, expose per target, pre-install safety gate, full audit.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tec-explorer/skillpot.git"
  },
  "bugs": {
    "url": "https://github.com/tec-explorer/skillpot/issues"
  },
  "homepage": "https://github.com/tec-explorer/skillpot#readme",
  "bin": {
    "skillpot": "dist/cli.mjs",
    "spot": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run typecheck && rm -rf dist && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node18 --jsx=automatic --alias:react-devtools-core=./src/shims/react-devtools-core.ts --banner:js='#!/usr/bin/env node\nimport { createRequire } from \"node:module\";\nconst require = createRequire(import.meta.url);' --outfile=dist/cli.mjs --log-level=warning && chmod +x dist/cli.mjs && npm run build:gui",
    "build:gui": "vite build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && bash scripts/e2e-sandbox.sh",
    "dev": "npm run typecheck -- --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "skills",
    "agent-skills",
    "supply-chain-security",
    "security",
    "governance",
    "prompt-injection",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "opencode",
    "zcode",
    "amp",
    "developer-tools",
    "typescript",
    "cli"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^5.2.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
